---
import BaseLayout from './BaseLayout.astro';

const { entry } = Astro.props;
const { title, description, date, tags } = entry.data;

const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<BaseLayout title={`${title} — Ghazals & Creative Inquiries`}>
  
  <!-- Atmospheric Classical Gradient Background -->
  <div class="fixed inset-0 pointer-events-none z-[-1] bg-gradient-to-b from-[#0D0814] via-[#140A1E] to-[#0A0510]"></div>

  <!-- Subtle Amber Star Dust Shimmer -->
  <div class="fixed inset-0 pointer-events-none z-0 opacity-25"
       style="background-image: radial-gradient(#F2A900 0.75px, transparent 0.75px); background-size: 32px 32px;">
  </div>

  <main class="max-w-[840px] mx-auto px-6 md:px-12 pt-20 pb-48 text-[#F5F2EB] relative z-10">
    
    <!-- Top Navigation -->
    <div class="mb-16 flex items-center justify-between border-b border-[#F2A900]/20 pb-4">
      <a href="/archive" class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#F5F2EB]/60 hover:text-[#F2A900] transition-colors flex items-center gap-2 group">
        <svg class="w-3 h-3 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        RETURN TO ARCHIVE
      </a>
      <div class="font-mono text-[9px] uppercase tracking-[0.25em] text-[#F2A900] flex items-center gap-2">
        <span>❊</span>
        <span>SCIENCE × GHAZAL</span>
        <span>❊</span>
      </div>
    </div>

    <!-- Classical Calligraphic Header -->
    <header class="text-center mb-20 max-w-2xl mx-auto">
      <div class="font-mono text-[10px] uppercase tracking-[0.4em] text-[#F2A900]/80 mb-6">
        DIWAN · {formattedDate}
      </div>

      <h1 class="font-cinematic text-4xl md:text-6xl text-[#F5F2EB] leading-[1.15] mb-6 tracking-normal">
        {title}
      </h1>

      <div class="flex items-center justify-center gap-4 my-8 opacity-60">
        <div class="w-16 h-[1px] bg-gradient-to-r from-transparent to-[#F2A900]"></div>
        <span class="text-[#F2A900] text-xs">✦</span>
        <div class="w-16 h-[1px] bg-gradient-to-l from-transparent to-[#F2A900]"></div>
      </div>

      <p class="font-literary text-lg md:text-xl text-[#F5F2EB]/75 italic leading-relaxed">
        {description}
      </p>
    </header>

    <!-- Poetry Card Container (Renaissance Parchment / Velvet Glass) -->
    <div class="rounded-3xl border border-[#F2A900]/20 bg-[#1A0E28]/50 backdrop-blur-3xl p-8 md:p-16 shadow-[0_20px_80px_rgba(0,0,0,0.6),inset_0_1px_1px_rgba(242,169,0,0.2)] relative overflow-hidden">
      
      <!-- Amber Corner Flourishes -->
      <div class="absolute top-4 left-4 text-[#F2A900]/30 font-mono text-xs select-none">┌</div>
      <div class="absolute top-4 right-4 text-[#F2A900]/30 font-mono text-xs select-none">┐</div>
      <div class="absolute bottom-4 left-4 text-[#F2A900]/30 font-mono text-xs select-none">└</div>
      <div class="absolute bottom-4 right-4 text-[#F2A900]/30 font-mono text-xs select-none">┘</div>

      <article class="prose max-w-none text-center
        prose-p:font-literary prose-p:text-xl md:prose-p:text-2xl prose-p:leading-[2.2] prose-p:text-[#F5F2EB] prose-p:my-6
        prose-headings:font-mono prose-headings:text-xs prose-headings:uppercase prose-headings:tracking-[0.3em] prose-headings:text-[#F2A900]
        prose-hr:border-[#F2A900]/20 prose-hr:my-10
      ">
        <slot />
      </article>

    </div>

    <!-- Colophon Note -->
    <footer class="mt-16 text-center">
      <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#F5F2EB]/40">
        COMPOSED AT MIDNIGHT BETWEEN MOLECULAR DYNAMICS RUNS
      </p>
    </footer>

  </main>
</BaseLayout>
