---
import BaseLayout from './BaseLayout.astro';
import { TYPE_COLORS } from '@lib/constants';

const { entry } = Astro.props;
const { title, description, date, type } = entry.data;

const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
const color = TYPE_COLORS[type] || 'text-bone';
---

<BaseLayout title={`${title} — Sk Anish Md`}>
  <!-- Very subtle film grain, no WebGL -->
  <div class="absolute inset-0 grain-overlay pointer-events-none z-0 opacity-10"></div>

  <main class="max-w-[720px] mx-auto px-6 md:px-0 pt-32 pb-48 relative z-10 selection:bg-white/20">
    
    <header class="mb-24">
      <div class="flex justify-between items-center mb-8 border-b border-white/10 pb-4">
        <span class="font-mono text-[10px] uppercase tracking-widest text-[#94A3B8]">ESSAY / REFLECTION</span>
        <span class="font-mono text-[10px] uppercase tracking-widest text-[#64748B]">{formattedDate}</span>
      </div>
      
      <h1 class="font-literary text-4xl md:text-5xl text-[#F8FAFC] leading-tight mb-8">
        {title}
      </h1>
      
      {description && (
        <p class="font-literary text-xl text-[#94A3B8] italic leading-relaxed">
          {description}
        </p>
      )}
    </header>

    <article class="prose prose-invert prose-lg max-w-[70ch] mx-auto
      prose-p:font-literary prose-p:text-[20px] prose-p:leading-[2.0] prose-p:text-[#CBD5E1] prose-p:mb-8
      prose-headings:font-cinematic prose-headings:text-[#F8FAFC] prose-headings:font-normal prose-headings:mt-16 prose-headings:mb-8
      prose-h1:text-4xl prose-h2:text-3xl prose-h3:text-2xl
      prose-a:text-[#F8FAFC] prose-a:underline prose-a:decoration-white/20 hover:prose-a:decoration-white transition-colors
      prose-blockquote:font-literary prose-blockquote:italic prose-blockquote:text-[#F8FAFC] prose-blockquote:border-l-white/20 prose-blockquote:bg-white/5 prose-blockquote:p-6 prose-blockquote:rounded-r-lg
      prose-strong:text-[#F8FAFC] prose-strong:font-semibold
      prose-ul:list-disc prose-ol:list-decimal prose-ul:pl-8 prose-ol:pl-8
      prose-li:text-[#CBD5E1] prose-li:font-literary prose-li:text-[18px] prose-li:mb-2
      first-letter:float-left first-letter:text-7xl first-letter:pr-4 first-letter:pt-2 first-letter:font-cinematic first-letter:text-white first-letter:leading-[0.8]
    ">
      <slot />
    </article>
    
    <!-- End Mark -->
    <div class="mt-24 flex justify-center">
      <span class="w-2 h-2 rounded-full bg-white/20"></span>
    </div>

  </main>
</BaseLayout>
