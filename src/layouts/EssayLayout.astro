---
import BaseLayout from './BaseLayout.astro';
import ShaderHero from '@components/canvas/ShaderHero.tsx';
import ParticleCloud from '@components/canvas/ParticleCloud.tsx';
import { TYPE_COLORS } from '@lib/constants';

const { entry } = Astro.props;
const { title, description, date, type } = entry.data;

const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
const color = TYPE_COLORS[type] || 'text-bone';
---

<BaseLayout title={`${title} - Sk Anish Md`}>
  
  <!-- Deep Background Scene (Fixed) -->
  <div class="fixed inset-0 z-0 w-full h-full pointer-events-none">
    <!-- Light Mode: Fluid Shader Hero with Instant Warm Sand CSS Fallback -->
    <div class="block dark:hidden absolute inset-0 ambient-light-bg">
      <div class="absolute inset-0 z-10">
        <ShaderHero client:only="react" theme="light" />
      </div>
    </div>

    <!-- Dark Mode: Fluid Shader Hero with Instant CSS Fallback -->
    <div class="hidden dark:block absolute inset-0 ambient-bg">
      <div class="absolute inset-0 z-10">
        <ShaderHero client:only="react" theme="dark" />
      </div>
    </div>
    
    <!-- Instant fine sand grain overlay (paints at 0ms, prevents flat fallback flash) -->
    <div class="absolute inset-0 z-20 pointer-events-none mix-blend-overlay opacity-20 dark:opacity-15" 
         style={{ backgroundImage: 'url("data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E")' }}>
    </div>
  </div>

  <main class="relative z-10 w-full max-w-4xl mx-auto px-6 md:px-12 pt-32 pb-48 selection:bg-white/20">
    
    <header class="mb-16 opacity-0 translate-y-8 animate-[fade-in-up_1.2s_cubic-bezier(0.16,1,0.3,1)_forwards]">
      <div class="flex justify-between items-center mb-12 pb-4 border-b border-black/10 dark:border-white/10">
        <a href="/archive" class="font-mono text-[10px] uppercase tracking-[0.2em] text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">← RETURN TO ARCHIVE</a>
        <span class="font-mono text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40">{formattedDate}</span>
      </div>
      
      <a href={Astro.url.pathname} class="block group">
        {title.toLowerCase().includes('bluff') ? (
          <h1 class="font-literary text-5xl md:text-6xl lg:text-7xl text-black dark:text-white leading-[1.05] tracking-tight mb-6 drop-shadow-xl transition-all duration-500 group-hover:scale-[1.005]">
            The Art of <span class="relative inline-block font-bold">
              <span class="relative z-10 text-black dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-r dark:from-[#6A1B9A] dark:via-[#F29900] dark:to-[#006E51] transition-transform duration-300 hover:scale-105 inline-block cursor-pointer">Bluff</span>
              <span class="hidden dark:inline-block absolute -top-3 -right-5 text-sm font-mono text-[#F29900] opacity-80 select-none animate-bounce">🃏</span>
            </span>
            <span class="block mt-4 text-3xl md:text-4xl lg:text-5xl font-cinematic font-normal text-black/80 dark:text-white/80">
              <span class="text-black dark:text-[#F29900] font-semibold tracking-wide">Confidence</span>
              <span class="font-mono text-xl md:text-2xl text-black/30 dark:text-white/30 mx-3 select-none">//</span>
              <span class="font-serif italic text-black/70 dark:text-[#006E51]">Competence</span>
            </span>
          </h1>
        ) : (
          <h1 class="font-literary text-5xl md:text-6xl lg:text-7xl text-black dark:text-white leading-[1.05] tracking-tight mb-8 drop-shadow-xl transition-all duration-500 group-hover:scale-[1.01] group-hover:drop-shadow-2xl">
            {title}
          </h1>
        )}
      </a>
      
      {description && (
        <p class="font-literary text-2xl text-black/60 dark:text-white/60 italic leading-relaxed max-w-3xl border-l-2 border-black/20 dark:border-white/20 pl-6">
          {description}
        </p>
      )}

      {title.toLowerCase().includes('bluff') && (
        <div class="mt-6 flex items-center gap-3 text-black/40 dark:text-white/40 pl-6">
          <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-[#B53A18]">TREMOR SIGNAL</span>
          <svg class="h-6 w-48 text-[#B53A18] dark:text-[#006E51]" viewBox="0 0 160 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 12 H58 L64 4 L70 20 L76 7 L82 17 L88 12 H160" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="animate-[pulse_3s_ease-in-out_infinite]" />
          </svg>
          <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-black/40 dark:text-white/40">R = 0.22 CORRELATION</span>
        </div>
      )}
    </header>

    <!-- Glass Reading Container -->
    <div class="rounded-2xl p-8 md:p-16 lg:p-20 opacity-0 translate-y-12 animate-[fade-in-up_1.5s_cubic-bezier(0.16,1,0.3,1)_0.2s_forwards] shadow-[0_0_80px_rgba(0,0,0,0.1)] dark:shadow-[0_0_120px_rgba(0,0,0,0.4)] relative overflow-hidden bg-[#F6F4F0]/80 dark:bg-[#050508]/40 backdrop-blur-[40px] border border-black/5 dark:border-white/10">
      
      <!-- Subtle Specular Mouse Highlight via CSS (glass-specular is in global.css) -->
      <div class="glass-specular hidden md:block"></div>

      <article class="relative z-10 prose prose-lg md:prose-xl max-w-[70ch] mx-auto
        dark:prose-invert 
        prose-p:font-literary prose-p:text-[20px] md:prose-p:text-[22px] prose-p:leading-[2.1] prose-p:text-black dark:prose-p:text-white dark:prose-p:drop-shadow-md prose-p:mb-8
        prose-headings:font-cinematic prose-headings:text-black dark:prose-headings:text-white dark:prose-headings:drop-shadow-md prose-headings:font-normal prose-headings:mt-20 prose-headings:mb-10
        prose-h1:text-4xl prose-h2:text-3xl prose-h3:text-2xl
        prose-a:text-black dark:prose-a:text-white prose-a:underline prose-a:decoration-black/30 dark:prose-a:decoration-white/30 hover:prose-a:decoration-black dark:hover:prose-a:decoration-white transition-colors
        prose-blockquote:font-literary prose-blockquote:italic prose-blockquote:text-black dark:prose-blockquote:text-white dark:prose-blockquote:drop-shadow-md prose-blockquote:border-l-black/20 dark:prose-blockquote:border-l-white/20 prose-blockquote:bg-black/5 dark:prose-blockquote:bg-white/5 prose-blockquote:p-8 prose-blockquote:rounded-r-xl
        prose-strong:text-black dark:prose-strong:text-white dark:prose-strong:drop-shadow-md prose-strong:font-semibold
        prose-ul:list-disc prose-ol:list-decimal prose-ul:pl-8 prose-ol:pl-8 prose-ul:mb-8 prose-ol:mb-8
        prose-li:text-black dark:prose-li:text-white dark:prose-li:drop-shadow-md prose-li:font-literary prose-li:text-[18px] md:prose-li:text-[20px] prose-li:leading-[1.9] prose-li:mb-3
        first-letter:float-left first-letter:text-[6rem] first-letter:pr-6 first-letter:pt-3 first-letter:font-cinematic first-letter:text-black dark:first-letter:text-white first-letter:leading-[0.7] first-letter:drop-shadow-xl
      ">
        <slot />
      </article>
    </div>
    
    <!-- End Mark -->
    <div class="mt-32 flex justify-center opacity-50">
      <div class="w-1 h-16 bg-gradient-to-b from-black/40 dark:from-white/40 to-transparent"></div>
    </div>

  </main>

  <script>
    // Automatically link in-text citations [1] to #ref-1 and handle smooth jump
    document.addEventListener('DOMContentLoaded', () => {
      const article = document.querySelector('article');
      if (!article) return;

      // Wrap numeric citations in text like [1] or [12, 13] with clickable links
      const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      let node;
      while ((node = walker.nextNode())) {
        if (node.parentElement && !['A', 'BUTTON', 'SCRIPT', 'STYLE', 'CODE', 'SPAN'].includes(node.parentElement.tagName)) {
          if (/\[\d+(?:,\s*\d+)*\]/.test(node.nodeValue || '')) {
            textNodes.push(node as Text);
          }
        }
      }

      textNodes.forEach(textNode => {
        const span = document.createElement('span');
        span.innerHTML = (textNode.nodeValue || '').replace(/\[(\d+(?:\s*,\s*\d+)*)\]/g, (match, nums) => {
          const links = nums.split(/\s*,\s*/).map(n => `<a href="#ref-${n}" class="citation-tag font-mono text-[12px] text-[#B53A18] dark:text-[#006E51] hover:text-[#F29900] dark:hover:text-[#F29900] font-semibold no-underline transition-colors px-0.5 select-none">${n}</a>`).join(', ');
          return `[${links}]`;
        });
        textNode.replaceWith(span);
      });

      // Handle clicking citation anchors
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('a[href^="#ref-"]');
        if (!target) return;
        const refId = target.getAttribute('href');
        if (!refId) return;

        // If the references dossier drawer is closed, open it!
        const details = document.getElementById('references-dossier') as HTMLDetailsElement;
        if (details && !details.open) {
          details.open = true;
        }

        const refEl = document.querySelector(refId);
        if (refEl) {
          e.preventDefault();
          refEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          refEl.classList.add('ring-2', 'ring-[#006E51]', 'bg-[#006E51]/20', 'scale-[1.02]');
          setTimeout(() => {
            refEl.classList.remove('ring-2', 'ring-[#006E51]', 'bg-[#006E51]/20', 'scale-[1.02]');
          }, 2500);
        }
      });
    });
  </script>
</BaseLayout>

