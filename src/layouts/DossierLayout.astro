---
import BaseLayout from './BaseLayout.astro';
import CircadianOscillator from '@components/canvas/CircadianOscillator.tsx';

const { entry } = Astro.props;
const { title, description, date, status, domain, technologies } = entry.data;

const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<BaseLayout title={`${title} — Chronotherapeutics Platform`}>
  
  <!-- Blueprint CSS Grid Background (SulkySubject Tech Style) -->
  <div class="fixed inset-0 pointer-events-none z-0" 
       style="background-size: 48px 48px; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);">
  </div>

  <!-- Deep space background layer -->
  <div class="fixed inset-0 pointer-events-none z-[-1] bg-[#070A10]"></div>

  <div class="max-w-[1400px] mx-auto px-6 pt-20 pb-32 relative z-10 flex flex-col xl:flex-row gap-10">
    
    <!-- Left HUD (Liquid Glass Dossier Metadata) -->
    <aside class="w-full xl:w-[320px] shrink-0">
      <div class="sticky top-20 bg-[#0F172A]/75 backdrop-blur-2xl border border-white/10 rounded-2xl p-6 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.15),0_20px_40px_-15px_rgba(0,0,0,0.8)] relative overflow-hidden">
        
        <!-- Top Navigation -->
        <a href="/archive" class="font-mono text-[9px] uppercase tracking-[0.25em] text-white/50 hover:text-white transition-colors flex items-center gap-2 mb-6 group">
          <svg class="w-3 h-3 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          RETURN TO ARCHIVE
        </a>

        <!-- Animated Specular Highlight -->
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#06B6D4]/50 to-transparent"></div>

        <div class="font-mono text-[10px] uppercase tracking-widest text-[#06B6D4] mb-6 pb-4 border-b border-white/10 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-[#06B6D4] animate-pulse"></span>
          CHRONOTHERAPEUTICS OS
        </div>

        <h1 class="font-cinematic text-3xl text-white mb-3 tracking-tight">{title}</h1>
        <p class="font-mono text-[11px] text-[#94A3B8] leading-relaxed mb-6">{description}</p>

        <div class="space-y-5 border-t border-white/10 pt-5">
          <div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-[#64748B] mb-1.5">DOMAIN</div>
            <div class="font-mono text-xs text-[#E2E8F0] uppercase font-bold">{domain || 'CIRCADIAN DRUG TIMING'}</div>
          </div>
          
          <div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-[#64748B] mb-1.5">PLATFORM STATUS</div>
            <div class="font-mono text-xs text-[#10B981] uppercase font-bold flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
              {status || 'ACTIVE ENGINE'}
            </div>
          </div>
          
          <div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-[#64748B] mb-2">TECH STACK</div>
            <div class="flex flex-wrap gap-1.5">
              {technologies && technologies.map((tech: string) => (
                <span class="font-mono text-[10px] bg-white/5 border border-white/10 px-2.5 py-1 rounded-md text-[#CBD5E1]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

      </div>
    </aside>

    <!-- Right Content (The Engine & Documentation) -->
    <main class="flex-1 space-y-10">
      
      <!-- Interactive Circadian Engine Island -->
      <section>
        <CircadianOscillator client:load />
      </section>

      <!-- Main Dossier Content -->
      <div class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-8 md:p-12 shadow-xl">
        <article class="prose prose-invert max-w-none
          prose-p:font-mono prose-p:text-[13px] prose-p:leading-relaxed prose-p:text-[#CBD5E1]
          prose-headings:font-mono prose-headings:text-white prose-headings:uppercase prose-headings:tracking-widest prose-headings:border-b prose-headings:border-white/10 prose-headings:pb-3
          prose-code:text-[#06B6D4] prose-code:bg-[#06B6D4]/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
          prose-pre:bg-[#050508] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-xl prose-pre:p-5
        ">
          <slot />
        </article>
      </div>

    </main>

  </div>
</BaseLayout>
