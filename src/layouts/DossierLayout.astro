---
import BaseLayout from './BaseLayout.astro';

const { entry } = Astro.props;
const { title, description, date, status, domain, technologies } = entry.data;

const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<BaseLayout title={`${title} — Dossier`}>
  
  <!-- Blueprint CSS Grid Background (SulkySubject Tech Style) -->
  <div class="fixed inset-0 pointer-events-none z-0" 
       style="background-size: 48px 48px; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);">
  </div>

  <!-- Deep space background layer -->
  <div class="fixed inset-0 pointer-events-none z-[-1] bg-[#0B0F17]"></div>

  <div class="max-w-[1400px] mx-auto px-6 pt-24 pb-32 relative z-10 flex flex-col xl:flex-row gap-12">
    
    <!-- Left HUD (Liquid Glass Dossier Metadata) -->
    <aside class="w-full xl:w-[320px] shrink-0">
      <div class="sticky top-24 bg-[#0F172A]/65 backdrop-blur-xl border border-white/10 rounded-xl p-6 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1),0_10px_30px_-10px_rgba(0,0,0,0.7)] relative overflow-hidden">
        
        <!-- Animated Specular Highlight -->
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#06B6D4]/50 to-transparent"></div>

        <div class="font-mono text-[10px] uppercase tracking-widest text-[#06B6D4] mb-8 pb-4 border-b border-white/10 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-[#06B6D4] animate-pulse"></span>
          ACTIVE DOSSIER
        </div>

        <h1 class="font-cinematic text-3xl text-white mb-2">{title}</h1>
        <p class="font-mono text-[11px] text-[#94A3B8] leading-relaxed mb-8">{description}</p>

        <div class="space-y-6">
          <div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-[#64748B] mb-2">DOMAIN</div>
            <div class="font-mono text-xs text-[#E2E8F0] uppercase">{domain || 'COMPUTATIONAL SYSTEM'}</div>
          </div>
          
          <div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-[#64748B] mb-2">STATUS</div>
            <div class="font-mono text-xs text-[#10B981] uppercase">{status || 'ONLINE'}</div>
          </div>
          
          <div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-[#64748B] mb-2">TECH STACK</div>
            <div class="flex flex-wrap gap-2">
              {technologies && technologies.map(tech => (
                <span class="font-mono text-[10px] bg-white/5 border border-white/10 px-2 py-1 rounded text-[#CBD5E1]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

      </div>
    </aside>

    <!-- Right Content (The Schema / Flow) -->
    <main class="flex-1 bg-[#111827]/40 backdrop-blur-md border border-white/5 rounded-xl p-8 md:p-12">
      <article class="prose prose-invert max-w-none
        prose-p:font-mono prose-p:text-[13px] prose-p:leading-relaxed prose-p:text-[#CBD5E1]
        prose-headings:font-mono prose-headings:text-white prose-headings:uppercase prose-headings:tracking-widest prose-headings:border-b prose-headings:border-white/10 prose-headings:pb-4
        prose-code:text-[#06B6D4] prose-code:bg-[#06B6D4]/10 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-[#050508] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-lg
      ">
        <slot />
      </article>
    </main>

  </div>
</BaseLayout>
