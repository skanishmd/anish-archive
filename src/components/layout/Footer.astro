  <div class="max-w-[1280px] mx-auto px-[clamp(1rem,4vw,3rem)] py-12 flex flex-col gap-12">
    
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8">
        <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-ash">
          DESIGNED & BUILT BY SK ANISH MD · {year}
        </p>
      <div class="flex items-center gap-6 flex-wrap">
        <a
          href="https://github.com/skanishmd"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[11px] tracking-[0.1em] uppercase text-ash hover:text-bone border-b border-transparent hover:border-bone pb-1 transition-colors duration-150"
        >
          GITHUB
        </a>
        <a
          href="https://www.linkedin.com/in/skanishmd/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[11px] tracking-[0.1em] uppercase text-ash hover:text-bone border-b border-transparent hover:border-bone pb-1 transition-colors duration-150"
        >
          LINKEDIN
        </a>
        <a
          href="https://www.instagram.com/sk4nishmd"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[11px] tracking-[0.1em] uppercase text-ash hover:text-bone border-b border-transparent hover:border-bone pb-1 transition-colors duration-150"
        >
          INSTAGRAM
        </a>
        <a
          href="mailto:skanishmd321@gmail.com"
          class="font-mono text-[11px] tracking-[0.1em] uppercase text-ash hover:text-bone border-b border-transparent hover:border-bone pb-1 transition-colors duration-150"
        >
          EMAIL
        </a>
      </div>
    </div>
  </div>
</footer>
