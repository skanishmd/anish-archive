---
// ThemeToggle.astro
// Ultra-premium glassy segmented control for Light / Dark / System modes.
---
<div class="relative p-1 rounded-full bg-[#E5E5E5]/50 dark:bg-[#1A1A1A]/80 backdrop-blur-2xl border border-white/20 dark:border-white/10 shadow-[0_8px_32px_rgba(0,0,0,0.1)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.4)] flex items-center gap-1 group">
  
  <button data-theme="light" class="theme-btn relative z-10 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-500 ease-out text-[#64748B] hover:text-[#0F172A] dark:text-[#64748B] dark:hover:text-white">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
  </button>
  
  <button data-theme="system" class="theme-btn relative z-10 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-500 ease-out text-[#64748B] hover:text-[#0F172A] dark:text-[#64748B] dark:hover:text-white">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
  </button>

  <button data-theme="dark" class="theme-btn relative z-10 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-500 ease-out text-[#64748B] hover:text-[#0F172A] dark:text-[#64748B] dark:hover:text-white">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>

  <!-- Animated Active Pill -->
  <div id="theme-pill" class="absolute top-1 left-1 w-10 h-10 rounded-full bg-white dark:bg-black shadow-md border border-black/5 dark:border-white/10 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] z-0 pointer-events-none"></div>
</div>

<script>
  const buttons = document.querySelectorAll('.theme-btn');
  const pill = document.getElementById('theme-pill');
  const themes = ['light', 'system', 'dark'];
  
  function applyTheme(theme: string) {
    if (theme === 'system') {
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', isDark);
      localStorage.removeItem('theme');
    } else {
      document.documentElement.classList.toggle('dark', theme === 'dark');
      localStorage.setItem('theme', theme);
    }
    updateUI(theme);
  }

  function updateUI(activeTheme: string) {
    const index = themes.indexOf(activeTheme);
    if (pill) {
      // 40px width + 4px gap = 44px step
      pill.style.transform = `translateX(${index * 44}px)`;
    }
    
    buttons.forEach((btn) => {
      if (btn.getAttribute('data-theme') === activeTheme) {
        btn.classList.add('text-black', 'dark:text-white');
        btn.classList.remove('text-[#64748B]', 'dark:text-[#64748B]');
      } else {
        btn.classList.remove('text-black', 'dark:text-white');
        btn.classList.add('text-[#64748B]', 'dark:text-[#64748B]');
      }
    });
  }

  const savedTheme = localStorage.getItem('theme') || 'system';
  applyTheme(savedTheme);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme');
      if (theme) applyTheme(theme);
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) applyTheme('system');
  });
</script>
