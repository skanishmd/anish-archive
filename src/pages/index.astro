---
import BaseLayout from '@layouts/BaseLayout.astro';
import ShaderHero from '@components/canvas/ShaderHero.tsx';
import LiquidLogo from '@components/canvas/LiquidLogo.tsx';

// Content species for the navigation
const species = [
  { name: 'Research', type: 'research', color: 'bg-[#FF2A00]' },
  { name: 'Technical', type: 'project', color: 'bg-[#0038FF]' },
  { name: 'Essays', type: 'writing', color: 'bg-[#00FF66]' },
  { name: 'Experiments', type: 'experiment', color: 'bg-[#00F0FF]' },
  { name: 'Achievements', type: 'achievement', color: 'bg-[#FFAA00]' },
];
---

<BaseLayout noHeaderFooter={true}>
  <main class="min-h-screen bg-transparent text-bone flex flex-col justify-center px-8 md:px-[10vw] relative overflow-hidden transition-colors duration-500">
    
    <!-- Light Mode Background (Structural Grid Blueprint) -->
    <div class="block dark:hidden absolute inset-0 -z-10 bg-[#F6F4F0]" style="background-image: linear-gradient(rgba(0,0,0,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.05) 1px, transparent 1px); background-size: 40px 40px;">
    </div>

    <!-- Dark Mode Background (ShaderGradient + Grain) -->
    <div class="hidden dark:block absolute inset-0 -z-10 bg-[#050508]">
      <ShaderHero client:only="react" />
    </div>

    <div class="max-w-7xl mx-auto w-full z-20 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 items-end pb-24 border-b border-black/10 dark:border-white/10">
      
      <!-- Left Column: Identity -->
      <div class="md:col-span-7 xl:col-span-8 flex flex-col opacity-0 translate-y-4 animate-[fade-in-up_1.2s_cubic-bezier(0.16,1,0.3,1)_forwards]">
        
        <div class="mb-10 scale-[1.2] origin-left">
          <LiquidLogo client:only="react" text="SK ANISH MD" color="currentColor" />
        </div>
        
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-ash dark:text-[#94A3B8] flex flex-wrap gap-x-8 gap-y-2 mb-12">
          <span>Bioinformatics</span>
          <span>Research</span>
          <span>Software</span>
          <span>Writing</span>
        </div>
        
        <p class="font-literary text-3xl md:text-5xl text-[#1A1A1A] dark:text-[#F8FAFC] max-w-3xl leading-[1.3] tracking-tight">
          The form of a page should reflect the nature of the knowledge it contains.
        </p>
      </div>

      <!-- Right Column: The Six Species Navigation -->
      <div class="md:col-span-5 xl:col-span-4 w-full flex flex-col gap-0 opacity-0 translate-y-4 animate-[fade-in-up_1.2s_cubic-bezier(0.16,1,0.3,1)_0.2s_forwards]">
        <div class="font-mono text-[9px] text-ash dark:text-[#94A3B8] uppercase tracking-[0.2em] mb-4 pb-2 border-b border-black/10 dark:border-white/10">
          Index [6]
        </div>
        
        <div class="flex flex-col border-t border-black/10 dark:border-white/10">
          {species.map((s, i) => (
            <a href={`/archive?type=${s.type}`} class="group flex items-center justify-between py-4 border-b border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300 relative overflow-hidden px-4 -mx-4">
              <div class="flex items-center gap-6 relative z-10">
                <span class="font-mono text-[10px] text-ash/50 dark:text-white/30">0{i + 1}</span>
                <span class="font-sans font-light text-lg tracking-wide text-black dark:text-[#F8FAFC] transition-colors">{s.name}</span>
              </div>
              <div class="flex items-center justify-center relative z-10">
                <span class={`w-1.5 h-1.5 rounded-full ${s.color} transition-transform duration-500 group-hover:scale-[2.5]`}></span>
              </div>
            </a>
          ))}
        </div>
        
        <a href="/archive" class="mt-8 self-end font-mono text-[10px] uppercase tracking-[0.2em] text-black dark:text-white hover:text-ash dark:hover:text-[#94A3B8] transition-colors flex items-center gap-4 group">
          View All Objects 
          <svg class="w-4 h-4 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
