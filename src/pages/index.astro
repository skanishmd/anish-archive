---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout noHeaderFooter={true}>
  <main class="min-h-screen bg-void text-bone flex flex-col justify-center px-8 md:px-[10vw]">
    <div class="max-w-4xl opacity-0 translate-y-4 animate-[fade-in-up_1s_ease-out_forwards]">
      
      <h1 class="font-cinematic font-semibold text-5xl md:text-7xl tracking-[0.05em] mb-8">
        ANISH MOHAMMAD
      </h1>
      
      <div class="font-mono text-[10px] md:text-xs uppercase tracking-[0.25em] text-ash flex flex-wrap gap-6 md:gap-10 mb-8">
        <span class="hover:text-bone transition-colors">Bioinformatics</span>
        <span class="hover:text-bone transition-colors">Research</span>
        <span class="hover:text-bone transition-colors">Software</span>
        <span class="hover:text-bone transition-colors">Writing</span>
        <span class="hover:text-bone transition-colors">Experiments</span>
      </div>
      
      <hr class="border-t border-white/10 mb-10 w-full" />
      
      <p class="font-literary text-2xl md:text-4xl text-bone/70 italic max-w-3xl leading-[1.6] mb-12">
        A living digital archive of a computational biologist's work, where writing, research, projects and evidence are connected as one system.
      </p>
      
      <div class="flex items-center gap-8">
        <a href="/archive" class="inline-flex items-center font-mono text-[11px] uppercase tracking-[0.2em] text-bone hover:text-signal-research transition-colors border border-white/20 px-6 py-3 hover:border-signal-research">
          [ Enter Archive ]
        </a>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
