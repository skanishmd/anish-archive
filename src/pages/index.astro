---
import BaseLayout from '@layouts/BaseLayout.astro';
import ShaderHero from '@components/canvas/ShaderHero.tsx';
import LiquidLogo from '@components/canvas/LiquidLogo.tsx';

const species = [
  { name: 'RESEARCH', type: 'research', color: 'bg-[#FF2A00]', pos: 'top-12 left-12' },
  { name: 'TECHNICAL', type: 'project', color: 'bg-[#0038FF]', pos: 'top-12 right-12' },
  { name: 'ESSAYS', type: 'writing', color: 'bg-[#00FF66]', pos: 'bottom-12 left-12' },
  { name: 'EXPERIMENTS', type: 'experiment', color: 'bg-[#00F0FF]', pos: 'bottom-12 right-12' },
  { name: 'ACHIEVEMENTS', type: 'achievement', color: 'bg-[#FFAA00]', pos: 'bottom-12 left-1/2 -translate-x-1/2' },
];
---

<BaseLayout noHeaderFooter={true}>
  <script>
    import 'liquid-glass-js';
  </script>

  <main class="h-screen w-full bg-transparent text-bone overflow-hidden relative selection:bg-white selection:text-black dark:selection:bg-black dark:selection:text-white">
    
    <!-- THE SCENE (Refracted by Liquid Glass) -->
    <div id="scene" class="absolute inset-0 z-0 w-full h-full flex flex-col items-center justify-center">
      
      <!-- Shader Backgrounds -->
      <div class="block dark:hidden absolute inset-0 ambient-light-bg opacity-100">
        <ShaderHero client:only="react" theme="light" />
      </div>
      <div class="hidden dark:block absolute inset-0 ambient-bg opacity-100">
        <ShaderHero client:only="react" theme="dark" />
      </div>

      <!-- Massive Brutalist Typography (To be refracted) -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none mix-blend-overlay dark:mix-blend-color-dodge opacity-80">
        <h1 class="font-cinematic text-[14vw] leading-[0.8] text-center tracking-tighter text-black dark:text-white font-black uppercase break-words w-full px-4 drop-shadow-2xl">
          THE PAPER <br/> CANNOT <br/> HANDLE <br/> YOU
        </h1>
      </div>
      
    </div>

    <!-- Liquid Glass Lens (Refracts the scene) -->
    <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none mix-blend-normal">
      <!-- Massive Desktop Lens -->
      <liquid-glass background="#scene" width="800" height="800" scale="60" radius="400" chroma="0.4" tint="0.0" edge="0.8" draggable="true" class="pointer-events-auto hidden md:block opacity-0 animate-[fade-in_3s_ease-out_forwards] drop-shadow-[0_0_100px_rgba(255,255,255,0.2)] dark:drop-shadow-[0_0_100px_rgba(0,0,0,0.5)]"></liquid-glass>
      <!-- Mobile Lens -->
      <liquid-glass background="#scene" width="340" height="500" scale="40" radius="170" chroma="0.3" tint="0.0" edge="0.6" draggable="true" class="pointer-events-auto block md:hidden opacity-0 animate-[fade-in_3s_ease-out_forwards]"></liquid-glass>
    </div>

    <!-- Foreground UI (Spatial Navigation & Identity) -->
    <div class="absolute inset-0 z-50 pointer-events-none">
      
      <!-- Central Floating Logo (Sits exactly inside the lens visually) -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 scale-[2.5] opacity-0 animate-[hero-logo-enter_2s_cubic-bezier(0.16,1,0.3,1)_1s_forwards] pointer-events-auto drop-shadow-2xl mix-blend-difference text-white">
        <LiquidLogo client:only="react" text="SK ANISH MD" color="currentColor" />
      </div>

      <!-- Spatial Navigation Corners -->
      {species.map((s, i) => (
        <a href={`/archive?type=${s.type}`} class={`absolute ${s.pos} group pointer-events-auto flex items-center gap-4 opacity-0 animate-[fade-in_1s_ease-out_${1.5 + (i * 0.2)}s_forwards]`}>
          <div class="flex items-center justify-center w-12 h-12 rounded-full border border-black/20 dark:border-white/20 bg-white/10 dark:bg-black/10 backdrop-blur-xl group-hover:scale-110 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden relative">
             <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 ${s.color}`}></div>
             <span class="font-mono text-[10px] text-black dark:text-white relative z-10">0{i + 1}</span>
          </div>
          <span class="font-mono text-xs tracking-[0.3em] text-black dark:text-white uppercase opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] absolute left-16 whitespace-nowrap drop-shadow-lg">
            {s.name}
          </span>
        </a>
      ))}
      
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes hero-logo-enter {
    from { opacity: 0; transform: translate(-50%, calc(-50% + 40px)); }
    to { opacity: 1; transform: translate(-50%, -50%); }
  }
  @keyframes fade-in {
    from { opacity: 0; filter: blur(10px); transform: scale(0.95); }
    to { opacity: 1; filter: blur(0px); transform: scale(1); }
  }
</style>
