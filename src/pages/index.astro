---
import BaseLayout from '@layouts/BaseLayout.astro';
import ShaderHero from '@components/canvas/ShaderHero.tsx';
import LiquidLogo from '@components/canvas/LiquidLogo.tsx';

const species = [
  { name: 'Research', type: 'research', color: 'bg-[#FF2A00]' },
  { name: 'Technical', type: 'project', color: 'bg-[#0038FF]' },
  { name: 'Essays', type: 'writing', color: 'bg-[#00FF66]' },
  { name: 'Experiments', type: 'experiment', color: 'bg-[#00F0FF]' },
  { name: 'Achievements', type: 'achievement', color: 'bg-[#FFAA00]' },
];
---

<BaseLayout noHeaderFooter={true}>
  <script>
    import 'liquid-glass-js';
    import gsap from 'gsap';

    document.addEventListener('DOMContentLoaded', () => {
      // Boot Sequence
      const tl = gsap.timeline();
      
      

      // Animate Main UI
      tl.fromTo('#hero-logo', { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, '-=0.5');
      tl.fromTo('#nav-dock', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, '-=0.8');

      // Kinetic Quote GSAP Animation
      const quoteWords = document.querySelectorAll('.quote-word');
      if (quoteWords.length > 0) {
        tl.fromTo(quoteWords, 
          { y: '120%', opacity: 0, rotationZ: 5 }, 
          { y: '0%', opacity: 1, rotationZ: 0, duration: 1.2, ease: 'power4.out', stagger: 0.05 },
          '-=0.8'
        );
      }

      // Lens Tracker
      const lensContainer = document.getElementById('lens-tracker');
      if (lensContainer && window.innerWidth >= 768) {
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let lensX = mouseX;
        let lensY = mouseY;
        
        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        function animate() {
          lensX += (mouseX - lensX) * 0.1;
          lensY += (mouseY - lensY) * 0.1;
          lensContainer.style.transform = `translate(${lensX - window.innerWidth/2}px, ${lensY - window.innerHeight/2}px)`;
          requestAnimationFrame(animate);
        }
        animate();
      }
    });
  </script>

<main class="h-screen w-full bg-transparent text-bone overflow-hidden relative selection:bg-white selection:text-black dark:selection:bg-black dark:selection:text-white">
    
    <!-- THE SCENE -->
    <div id="scene" class="absolute inset-0 z-0 w-full h-full">
      <div class="block dark:hidden absolute inset-0 ambient-light-bg opacity-100">
        <ShaderHero client:only="react" theme="light" />
      </div>
      <div class="hidden dark:block absolute inset-0 ambient-bg opacity-100">
        <ShaderHero client:only="react" theme="dark" />
      </div>
    </div>

    <!-- Liquid Glass Lens Tracker -->
    <div id="lens-tracker" class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none mix-blend-normal will-change-transform">
      <liquid-glass background="#scene" width="600" height="600" scale="50" radius="300" chroma="0.25" tint="0.0" edge="0.6" class="pointer-events-none hidden md:block opacity-0 animate-[fade-in_3s_ease-out_1s_forwards] drop-shadow-[0_0_80px_rgba(255,255,255,0.1)] dark:drop-shadow-[0_0_80px_rgba(0,0,0,0.4)]"></liquid-glass>
      <liquid-glass background="#scene" width="340" height="500" scale="40" radius="170" chroma="0.3" tint="0.0" edge="0.6" draggable="true" class="pointer-events-auto block md:hidden opacity-0 animate-[fade-in_3s_ease-out_1s_forwards]"></liquid-glass>
    </div>

    <!-- Spatial Cinematic UI -->
    <div class="absolute inset-0 z-20 flex flex-col items-center justify-between p-8 md:p-12 pointer-events-none">
      
      <!-- Top: Identity -->
      <div id="hero-logo" class="w-full flex justify-between items-start pointer-events-auto opacity-0">
        <div class="scale-[1.2] origin-top-left">
          <LiquidLogo client:only="react" text="SK ANISH MD" color="currentColor" />
        </div>
        <div class="font-mono text-[9px] uppercase tracking-[0.3em] text-black dark:text-white text-right drop-shadow-md">
          Polymath<br/>Scientist
        </div>
      </div>

      <!-- Center: Kinetic Quote -->
      <div class="w-full max-w-4xl mx-auto flex flex-col items-center text-center pointer-events-none z-30 text-black dark:text-white">
        <h2 class="font-literary text-4xl md:text-5xl lg:text-7xl leading-[1.1] tracking-tight drop-shadow-xl dark:drop-shadow-[0_4px_24px_rgba(0,0,0,1)] flex flex-wrap justify-center gap-x-[0.25em] gap-y-2">
          
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">There</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">are</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">poems</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">inside</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">you</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left italic font-light opacity-80">that</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left italic font-light opacity-80">even</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left italic font-light opacity-80">the</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left italic font-light opacity-80">paper</span></span>
          
          <div class="w-full h-0"></div> <!-- Force line break here -->
          
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">can't</span></span>
          <span class="overflow-hidden inline-flex"><span class="quote-word inline-block origin-bottom-left">handle.</span></span>
          
        </h2>
      </div>

      <!-- Bottom: The Six Species Horizontal Dock -->
      <div id="nav-dock" class="w-full flex flex-col items-center gap-6 pointer-events-auto z-40 opacity-0">
        
        <div class="font-mono text-[9px] text-black/50 dark:text-white/50 uppercase tracking-[0.4em] drop-shadow-md">
          Index [{species.length}]
        </div>

        <div class="flex flex-wrap justify-center gap-3 md:gap-4">
          {species.map((s, i) => (
            <a href={`/archive?type=${s.type}`} class="group relative px-6 py-3 rounded-full border border-black/10 dark:border-white/10 bg-white/5 dark:bg-black/5 backdrop-blur-xl hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-500 ease-out hover:scale-110 overflow-hidden">
              <div class="flex items-center gap-3 relative z-10">
                <div class="w-1.5 h-1.5 rounded-full transition-transform duration-500 group-hover:scale-[3]" class:list={[s.color]}></div>
                <span class="font-mono text-xs font-medium tracking-[0.2em] text-black dark:text-white uppercase">{s.name}</span>
              </div>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-20 transition-opacity duration-500" class:list={[s.color]}></div>
            </a>
          ))}
        </div>

        <a href="/archive" class="mt-4 font-mono text-[9px] uppercase tracking-[0.3em] font-bold text-black/70 dark:text-white/70 hover:text-black dark:hover:text-white transition-colors flex items-center gap-2 group">
          View All Objects 
          <svg class="w-3 h-3 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>

      </div>

    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fade-in {
    from { opacity: 0; filter: blur(10px); transform: scale(0.95); }
    to { opacity: 1; filter: blur(0px); transform: scale(1); }
  }
</style>



