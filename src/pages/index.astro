---
import BaseLayout from '@layouts/BaseLayout.astro';
import ShaderHero from '@components/canvas/ShaderHero.tsx';
import GoogleLabsGeometry from '@components/canvas/GoogleLabsGeometry.tsx';
import ParticleCloud from '@components/canvas/ParticleCloud.tsx';
import LiquidLogo from '@components/canvas/LiquidLogo.tsx';

// Content species for the navigation
const species = [
  { name: 'Research', type: 'research', color: 'bg-[#FF2A00]' },
  { name: 'Technical', type: 'project', color: 'bg-[#0038FF]' },
  { name: 'Essays', type: 'writing', color: 'bg-[#00FF66]' },
  { name: 'Experiments', type: 'experiment', color: 'bg-[#00F0FF]' },
  { name: 'Achievements', type: 'achievement', color: 'bg-[#FFAA00]' },
];
---

<BaseLayout noHeaderFooter={true}>
  <!-- Import liquid-glass-js -->
  <script>
    import 'liquid-glass-js';
  </script>

  <main class="min-h-screen bg-transparent text-bone flex flex-col justify-center px-8 md:px-[10vw] relative overflow-hidden transition-colors duration-500">
    
    <!-- The background to refract -->
    <div id="scene" class="absolute inset-0 -z-20 w-full h-full">
      <!-- Light Mode Background -->
      <div class="block dark:hidden absolute inset-0">
        <GoogleLabsGeometry client:only="react" />
      </div>

      <!-- Dark Mode Background -->
      <div class="hidden dark:block absolute inset-0">
        <ShaderHero client:only="react" />
      </div>
    </div>

    <!-- The actual floating liquid glass objects -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <liquid-glass background="#scene" width="300" height="400" x="10vw" y="15vh"
                    scale="50" chroma="0.15" tint="0" edge="0.8" draggable="true" class="pointer-events-auto hidden md:block">
      </liquid-glass>
      
      <liquid-glass background="#scene" width="450" height="250" x="60vw" y="50vh"
                    scale="60" chroma="0.2" tint="0.05" edge="1.0" draggable="true" class="pointer-events-auto hidden md:block">
      </liquid-glass>
    </div>

    <div class="max-w-6xl w-full z-20 flex flex-col md:flex-row justify-between items-start md:items-center gap-16 relative">
      
      <!-- Left Column: Identity -->
      <div class="flex-1 opacity-0 translate-y-4 animate-[fade-in-up_1s_cubic-bezier(0.16,1,0.3,1)_forwards] pointer-events-none">
        <div class="mb-4 scale-[2.0] origin-left">
          <LiquidLogo client:only="react" text="SK ANISH MD" color="currentColor" />
        </div>
        
        <div class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.4em] text-ash dark:text-[#94A3B8] flex flex-wrap gap-x-8 gap-y-4 mb-16 stagger-fade max-w-xl">
          <span class="bg-black/5 dark:bg-white/5 px-2 py-1 border border-black/10 dark:border-white/10 rounded-sm">Bioinformatics</span>
          <span class="bg-black/5 dark:bg-white/5 px-2 py-1 border border-black/10 dark:border-white/10 rounded-sm">Research</span>
          <span class="bg-black/5 dark:bg-white/5 px-2 py-1 border border-black/10 dark:border-white/10 rounded-sm">Software</span>
          <span class="bg-black/5 dark:bg-white/5 px-2 py-1 border border-black/10 dark:border-white/10 rounded-sm">Writing</span>
        </div>
        
        <p class="font-literary text-3xl md:text-5xl lg:text-[4rem] text-[#111] dark:text-[#F8FAFC] italic max-w-3xl leading-[1.1] tracking-tight">
          The form of a page should reflect the <span class="bg-black dark:bg-white text-white dark:text-black px-4 py-1 inline-block transform -rotate-1 rounded-sm">nature</span> of the knowledge it contains.
        </p>
      </div>

      <!-- Right Column: The Six Species Navigation (Sulkysubject / SLP inspired) -->
      <div class="w-full md:w-auto flex flex-col gap-6 opacity-0 translate-y-4 animate-[fade-in-up_1s_cubic-bezier(0.16,1,0.3,1)_0.2s_forwards] z-20">
        <div class="font-mono text-[9px] text-ash dark:text-[#94A3B8] uppercase tracking-[0.3em] mb-2 pl-6 border-l-2 border-black/20 dark:border-white/20 transition-colors">
          Explore The Graph [6]
        </div>
        
        <div class="flex flex-col gap-3">
          {species.map((s, i) => (
            <a href={`/archive?type=${s.type}`} class="group flex items-center justify-between gap-16 px-8 py-5 rounded-2xl border border-black/5 dark:border-white/5 bg-white/60 dark:bg-[#0A0A0A]/60 backdrop-blur-xl hover:bg-white/90 dark:hover:bg-[#111827]/90 hover:border-black/20 dark:hover:border-white/20 hover:-translate-y-2 hover:scale-[1.02] transition-all duration-500 relative overflow-hidden shadow-xl dark:shadow-[0_10px_40px_-10px_rgba(0,0,0,0.8)]">
              
              <!-- Hover Background Glow -->
              <div class="absolute inset-0 opacity-0 group-hover:opacity-20 transition-opacity duration-700 pointer-events-none" style={`background: radial-gradient(circle at 100% 50%, ${s.color}, transparent 60%)`}></div>
              
              <div class="flex items-center gap-6 relative z-10">
                <span class="font-mono text-[10px] text-ash/50 dark:text-white/30">0{i + 1}</span>
                <span class="font-cinematic text-2xl md:text-3xl text-black dark:text-[#F8FAFC] tracking-widest transition-colors">{s.name}</span>
              </div>
              <div class="flex items-center justify-center w-8 h-8 rounded-full border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 relative z-10 transition-colors group-hover:bg-black/10 dark:group-hover:bg-white/20">
                <span class={`w-2.5 h-2.5 rounded-full ${s.color} transition-all duration-700 group-hover:scale-150 group-hover:shadow-[0_0_20px_4px_currentColor]`}></span>
              </div>
            </a>
          ))}
        </div>
        
        <a href="/archive" class="mt-8 self-end font-mono text-[11px] uppercase tracking-[0.3em] font-bold text-black dark:text-white hover:text-[#FF8A5B] dark:hover:text-[#06B6D4] transition-colors flex items-center gap-4 group">
          View All Objects 
          <span class="w-12 h-[2px] bg-current group-hover:w-24 transition-all duration-500"></span>
        </a>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
