---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const collectionNames = ['observations', 'projects', 'research', 'writing', 'achievements', 'creative'] as const;

// Signal color map per collection
const signalColor: Record<string, string> = {
  observations: '#00F0FF',
  projects:     '#0038FF',
  research:     '#FF2A00',
  writing:      '#00FF66',
  achievements: '#FFAA00',
  creative:     '#9D00FF',
};

const collectionLabel: Record<string, string> = {
  observations: 'OBS',
  projects:     'SYS',
  research:     'RES',
  writing:      'WRT',
  achievements: 'ACH',
  creative:     'CRE',
};

interface ArchiveItem {
  id: string;
  collection: string;
  href: string;
  title: string;
  description: string;
  date: string;
  tags: string[];
  fields: string[];
  featured: boolean;
  color: string;
  label: string;
}

const allItems: ArchiveItem[] = [];
for (const name of collectionNames) {
  const entries = await getCollection(name);
  for (const entry of entries) {
    if (entry.data.status !== 'archived') {
      allItems.push({
        id: entry.id,
        collection: name,
        href: `/archive/${name}/${entry.id}`,
        title: entry.data.title,
        description: entry.data.description,
        date: entry.data.date.toISOString().slice(0, 10),
        tags: entry.data.tags,
        fields: entry.data.fields || [],
        featured: entry.data.featured || false,
        color: signalColor[name],
        label: collectionLabel[name],
      });
    }
  }
}

// Sort by date descending
allItems.sort((a, b) => b.date.localeCompare(a.date));

const totalItems = allItems.length;
---

<BaseLayout title="Archive — Sk Anish Md">
  <div class="max-w-[1400px] mx-auto px-[clamp(1rem,4vw,3rem)] pt-28 pb-24">

    <!-- Archive Header (SLP.gallery inspired) -->
    <div class="border-b border-hairline pb-6 mb-12">
      <div class="flex items-end justify-between">
        <div>
          <p class="t-label text-ash mb-2">SK ANISH MD // ARCHIVE</p>
          <h1 class="font-mono text-[28px] md:text-[40px] tracking-[-0.02em] text-bone leading-none">
            ALL OBJECTS
          </h1>
        </div>
        <div class="text-right">
          <p class="t-label text-ash mb-1">TOTAL</p>
          <p class="font-mono text-[28px] text-ash">{String(totalItems).padStart(3, '0')}</p>
        </div>
      </div>

      <!-- Filter bar -->
      <div class="mt-8 flex flex-wrap gap-3" id="filter-bar">
        <button
          class="filter-btn active font-mono text-[10px] uppercase tracking-[0.12em] px-3 py-1.5 border border-hairline text-ash hover:border-bone hover:text-bone transition-all duration-150"
          data-filter="all"
        >
          ALL
        </button>
        {Object.entries(collectionLabel).map(([col, lbl]) => (
          <button
            class="filter-btn font-mono text-[10px] uppercase tracking-[0.12em] px-3 py-1.5 border border-hairline text-ash hover:border-bone hover:text-bone transition-all duration-150"
            data-filter={col}
            style={`--signal: ${signalColor[col]}`}
          >
            {lbl} — {col}
          </button>
        ))}
      </div>
    </div>

    <!-- Pixel Bloom Grid (slp.gallery inspired) -->
    <div
      id="archive-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-px bg-hairline border border-hairline"
    >
      {allItems.map((item) => (
        <a
          href={item.href}
          class="pixel-bloom-item bg-void group"
          data-collection={item.collection}
          style={`--signal-color: ${item.color}`}
        >
          <!-- Pixel blob preview (the "before" state) -->
          <div class="pixel-bloom-preview h-[160px] flex items-center justify-center" style={`background: ${item.color}08`}>
            <!-- 4x4 pixelated color block -->
            <div
              class="w-12 h-12"
              style={`
                background-color: ${item.color};
                image-rendering: pixelated;
                box-shadow:
                  8px 0 0 0 ${item.color}88,
                  -8px 0 0 0 ${item.color}44,
                  0 8px 0 0 ${item.color}66,
                  0 -8px 0 0 ${item.color}33,
                  16px 8px 0 0 ${item.color}22,
                  -16px -8px 0 0 ${item.color}44;
                opacity: 0.7;
              `}
            ></div>
          </div>

          <!-- Full card content (the "after" reveal) -->
          <div class="pixel-bloom-content p-4 border-t border-hairline">
            <div class="flex items-center justify-between mb-2">
              <span
                class="t-caption"
                style={`color: ${item.color}`}
              >{item.label}</span>
              <span class="t-label text-ash">{item.date}</span>
            </div>
            <h3 class="font-mono text-[11px] text-bone leading-tight mb-2 line-clamp-2 tracking-[0.02em]">
              {item.title}
            </h3>
            <p class="font-sans text-[10px] text-bone-muted leading-relaxed line-clamp-2 mb-3">
              {item.description}
            </p>
            <div class="flex flex-wrap gap-1">
              {item.tags.slice(0, 2).map(tag => (
                <span class="t-label text-ash border border-hairline px-1 py-0.5">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Hover accent line at top -->
          <div
            class="absolute top-0 left-0 right-0 h-[2px] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
            style={`background: ${item.color}`}
          ></div>
        </a>
      ))}
    </div>

    <!-- Empty state -->
    {allItems.length === 0 && (
      <div class="py-32 text-center">
        <p class="t-caption text-ash">NO OBJECTS IN ARCHIVE</p>
      </div>
    )}
  </div>

  <!-- Filter + specular JS -->
  <script>
    // Filter buttons
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const gridItems = document.querySelectorAll<HTMLElement>('.pixel-bloom-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        // Update active state
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter items
        gridItems.forEach(item => {
          const col = item.dataset.collection;
          const show = filter === 'all' || col === filter;
          item.style.display = show ? '' : 'none';
        });
      });
    });

    // Glass specular on any glass-cards that appear here
    document.querySelectorAll('.glass-card').forEach(card => {
      card.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = ((me.clientX - rect.left) / rect.width) * 100;
        const y = ((me.clientY - rect.top) / rect.height) * 100;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}%`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}%`);
      });
    });
  </script>

  <style>
    .filter-btn.active {
      border-color: var(--signal, #F0EDE8);
      color: var(--signal, #F0EDE8);
    }

    /* Pixel bloom item must be position:relative for the accent line */
    .pixel-bloom-item {
      position: relative;
      overflow: hidden;
    }

    /* The pixel preview takes the full card when not hovered */
    .pixel-bloom-item .pixel-bloom-preview {
      position: relative;
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .pixel-bloom-item .pixel-bloom-content {
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transform: translateY(6px);
      transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s, max-height 0.4s ease;
    }

    /* On hover: collapse preview, bloom content */
    .pixel-bloom-item:hover .pixel-bloom-preview {
      opacity: 0;
      transform: scale(0.95);
      position: absolute;
      pointer-events: none;
    }

    .pixel-bloom-item:hover .pixel-bloom-content {
      opacity: 1;
      max-height: 300px;
      transform: translateY(0);
    }

    /* Author Mode: stronger accent, more saturated */
    html[data-mode="author"] .pixel-bloom-item:hover {
      box-shadow: 0 0 30px color-mix(in srgb, var(--signal-color) 30%, transparent);
    }
  </style>
</BaseLayout>
