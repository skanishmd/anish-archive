---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const collectionNames = ['observations', 'projects', 'research', 'writing', 'achievements', 'creative'] as const;

// Signal color map per collection
const signalColor: Record<string, string> = {
  observations: '#00F0FF',
  projects:     '#0038FF',
  research:     '#FF2A00',
  writing:      '#00FF66',
  achievements: '#FFAA00',
  creative:     '#9D00FF',
};

const collectionLabel: Record<string, string> = {
  observations: 'OBS',
  projects:     'SYS',
  research:     'RES',
  writing:      'WRT',
  achievements: 'ACH',
  creative:     'CRE',
};

// Fetch all entries
let allItems = [];
for (const col of collectionNames) {
  const entries = await getCollection(col);
  const mapped = entries.map(e => ({
    href: `/archive/${col}/${e.slug}`,
    collection: col,
    label: collectionLabel[col],
    color: signalColor[col],
    title: e.data.title,
    description: e.data.description,
    date: e.data.date.toISOString().slice(0, 10).replace(/-/g, ' '),
    tags: e.data.tags || [],
    timestamp: e.data.date.getTime(),
  }));
  allItems = [...allItems, ...mapped];
}

// Sort descending by date
allItems.sort((a, b) => b.timestamp - a.timestamp);
---

<BaseLayout title="Archive — Sk Anish Md">
  
  <div class="absolute inset-0 ambient-bg pointer-events-none z-0 mix-blend-screen opacity-60"></div>
  <div class="absolute inset-0 grain-overlay pointer-events-none z-0 opacity-10"></div>

  <div class="max-w-[1400px] mx-auto px-6 md:px-12 pt-32 pb-32 relative z-10">
    
    <!-- Header -->
    <header class="flex flex-col md:flex-row justify-between items-end mb-16 border-b border-black/10 dark:border-white/10 pb-8 transition-colors">
      <div>
        <div class="font-mono text-[9px] uppercase tracking-widest text-ash dark:text-[#94A3B8] mb-4 flex items-center gap-4">
          <span>SK ANISH MD</span>
          <span class="w-8 h-[1px] bg-black/10 dark:bg-white/10"></span>
          <span>THE GRAPH</span>
        </div>
        <h1 class="font-cinematic text-4xl md:text-5xl text-black dark:text-[#F8FAFC] tracking-wide">
          ARCHIVE INDEX
        </h1>
      </div>
      <div class="font-mono text-[11px] text-[#94A3B8] mt-8 md:mt-0">
        TOTAL : {String(allItems.length).padStart(3, '0')}
      </div>
    </header>

    <!-- Filters (SLP Style) -->
    <div class="mb-12 overflow-x-auto pb-4 hide-scrollbar">
      <div class="flex gap-3">
        <button class="filter-btn active font-mono text-[10px] uppercase tracking-wider px-4 py-2 border border-black/10 dark:border-white/10 text-black dark:text-white bg-black/10 dark:bg-white/10 rounded-md transition-colors whitespace-nowrap" data-filter="all">
          ALL
        </button>
        {Object.entries(collectionLabel).map(([col, lbl]) => (
          <button 
            class="filter-btn font-mono text-[10px] uppercase tracking-wider px-4 py-2 border border-black/5 dark:border-white/5 text-ash dark:text-[#94A3B8] hover:border-black/20 dark:hover:border-white/20 transition-colors whitespace-nowrap rounded-md" 
            data-filter={col}
            style={`--active-bg: ${signalColor[col]}20; --active-border: ${signalColor[col]};`}
          >
            {lbl} — {col}
          </button>
        ))}
      </div>
    </div>

    <!-- The Masonry/Gallery Grid (Sulkysubject x SLP) -->
    <div id="archive-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      
      {allItems.map((item, index) => {
        // Compute RGB for box-shadows
        const r = parseInt(item.color.slice(1, 3), 16);
        const g = parseInt(item.color.slice(3, 5), 16);
        const b = parseInt(item.color.slice(5, 7), 16);
        const rgb = `${r}, ${g}, ${b}`;

        return (
          <a href={item.href} 
             class="archive-card group flex flex-col h-[280px] bg-transparent border border-black/20 dark:border-white/20 hover:border-black dark:hover:border-white transition-all duration-300 relative overflow-hidden"
             data-collection={item.collection}
             style={`--signal: ${item.color};`}
          >
            <!-- Top Structural Signal Line -->
            <div class="absolute top-0 left-0 right-0 h-[1px] bg-current transition-all duration-300 group-hover:h-[4px]" style={`color: ${item.color}`}></div>
            
            <div class="p-6 flex flex-col h-full z-10 relative">
              <!-- Meta -->
              <div class="flex justify-between items-center mb-6">
                <span class="font-mono text-[9px] font-semibold uppercase tracking-[0.2em]" style={`color: ${item.color}`}>{item.label}</span>
                <span class="font-mono text-[9px] text-ash dark:text-[#64748B] tracking-[0.1em]">{item.date}</span>
              </div>
              
              <!-- Content -->
              <h3 class="font-sans font-light text-[20px] leading-[1.2] text-black dark:text-[#F8FAFC] mb-4 line-clamp-3">
                {item.title}
              </h3>
              <p class="font-serif text-[14px] text-ash dark:text-[#94A3B8] line-clamp-3 mb-6">
                {item.description}
              </p>
              
              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mt-auto">
                {item.tags.slice(0, 3).map(tag => (
                  <span class="font-mono text-[8px] uppercase tracking-[0.2em] text-ash dark:text-[#94A3B8] bg-black/5 dark:bg-white/5 px-2 py-1 transition-colors group-hover:bg-black/10 dark:group-hover:bg-white/10">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Hover overlay subtly -->
            <div class="absolute inset-0 z-0 bg-black/[0.02] dark:bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
            </div>
          </a>
        )
      })}

    </div>

  </div>

  <script>
    // Filtering logic
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.archive-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';
        
        // Reset buttons
        filterBtns.forEach(b => {
          b.classList.remove('active', 'text-white', 'bg-white/10');
          b.style.borderColor = 'rgba(255,255,255,0.05)';
          b.style.backgroundColor = 'transparent';
          b.style.color = '#94A3B8';
        });
        
        // Activate button
        btn.classList.add('active');
        if(filter === 'all') {
          btn.classList.add('text-white', 'bg-white/10');
          btn.style.borderColor = 'rgba(255,255,255,0.1)';
        } else {
          btn.style.borderColor = btn.style.getPropertyValue('--active-border');
          btn.style.backgroundColor = btn.style.getPropertyValue('--active-bg');
          btn.style.color = '#fff';
        }

        // Animate cards out, then in
        cards.forEach(card => {
          if (filter === 'all' || card.dataset.collection === filter) {
            card.style.display = 'flex';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'scale(1)';
            }, 10);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 300);
          }
        });
      });
    });
  </script>
</BaseLayout>
