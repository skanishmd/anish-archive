---
import { getCollection, render } from 'astro:content';
import EssayLayout from '@layouts/EssayLayout.astro';
import DossierLayout from '@layouts/DossierLayout.astro';
import LabLayout from '@layouts/LabLayout.astro';
import ResearchLayout from '@layouts/ResearchLayout.astro';
import CreativeLayout from '@layouts/CreativeLayout.astro';

export async function getStaticPaths() {
  const collectionNames = ['observations', 'projects', 'research', 'writing', 'achievements', 'creative'] as const;
  const paths = [];
  const allEntries: Map<string, any> = new Map();

  for (const name of collectionNames) {
    const entries = await getCollection(name);
    for (const entry of entries) {
      allEntries.set(entry.id, { ...entry, collectionName: name });
      paths.push({
        params: { slug: `${name}/${entry.slug || entry.id}` },
        props: { entry, collectionName: name },
      });
    }
  }

  return paths;
}

const { entry, collectionName } = Astro.props;
const { Content } = await render(entry);

// Determine the layout based on content species
// Each type gets its own curated visual universe (Anthology Architecture)
const type = entry.data.type || 'writing';

let Layout = EssayLayout; // Default: Investigative Broadsheet (dark Joker sand)

if (type === 'project' || type === 'system') {
  Layout = DossierLayout;          // ChronoBase: Space-grade HUD + Circadian Engine
} else if (type === 'experiment') {
  Layout = LabLayout;              // Lab notebook aesthetic
} else if (type === 'research') {
  Layout = ResearchLayout;         // Clinical Crystallography + 3D Kinase Viewer
} else if (type === 'achievement') {
  Layout = EssayLayout;            // Clean literary record
} else if (type === 'creative') {
  Layout = CreativeLayout;         // Ghazal: Mughal/Renaissance velvet + amber stardust
}
---

<Layout entry={entry}>
  <Content />
</Layout>
