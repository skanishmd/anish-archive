---
import { getCollection, render } from 'astro:content';
import EssayLayout from '@layouts/EssayLayout.astro';
import DossierLayout from '@layouts/DossierLayout.astro';
import LabLayout from '@layouts/LabLayout.astro';
import ResearchLayout from '@layouts/ResearchLayout.astro';

export async function getStaticPaths() {
  const collectionNames = ['observations', 'projects', 'research', 'writing', 'achievements', 'creative'] as const;
  const paths = [];
  const allEntries: Map<string, any> = new Map();

  for (const name of collectionNames) {
    const entries = await getCollection(name);
    for (const entry of entries) {
      allEntries.set(entry.id, { ...entry, collectionName: name });
      paths.push({
        params: { slug: `${name}/${entry.slug || entry.id}` },
        props: { entry, collectionName: name },
      });
    }
  }

  return paths;
}

const { entry, collectionName } = Astro.props;
const { Content } = await render(entry);

// Determine the layout based on the content species
const type = entry.data.type || 'writing';

let Layout = EssayLayout; // Default to literary

if (type === 'project' || type === 'system') {
  Layout = DossierLayout;
} else if (type === 'experiment') {
  Layout = LabLayout;
} else if (type === 'research') {
  Layout = ResearchLayout;
} else if (type === 'achievement') {
  Layout = EssayLayout; // We'll make a specific RecordLayout later
}
---

<Layout entry={entry}>
  <Content />
</Layout>
