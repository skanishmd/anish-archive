---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout title="404">
  <div class="flex flex-col items-center justify-center min-h-[60vh] gap-6">
    <h1 class="font-mono text-6xl tracking-[0.05em] text-ash">404</h1>
    <p class="font-mono text-[13px] tracking-[0.05em] uppercase text-ash">
      OBJECT NOT FOUND IN ARCHIVE
    </p>
    <a
      href="/"
      class="font-mono text-[13px] tracking-[0.05em] uppercase text-bone border border-hairline px-4 py-2 hover:bg-bone hover:text-void transition-colors duration-150"
    >
      ← RETURN TO ARCHIVE
    </a>
  </div>
</PageLayout>
